        "source": "SELECT metric_date, total_transactions, total_volume, avg_ticket_size, active_customers, active_merchants FROM credit_transactions.gold.daily_business_metrics WHERE metric_date = (SELECT MAX(metric_date) FROM credit_transactions.gold.daily_business_metrics)\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          }
        ],
        "measures": [
          {
            "name": "total_transactions",
            "expr": "SUM(total_transactions)"
          },
          {
            "name": "total_volume",
            "expr": "SUM(total_volume)"
          },
          {
            "name": "avg_ticket_size",
            "expr": "SUM(avg_ticket_size)"
          },
          {
            "name": "active_customers",
            "expr": "SUM(active_customers)"
          },
          {
            "name": "active_merchants",
            "expr": "SUM(active_merchants)"
          }
        ]
      }
    },
    {
      "name": "business_metrics_30d",
      "displayName": "Business Metrics 30 Days",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, total_transactions, total_volume, avg_ticket_size, active_customers,\n       active_merchants, volume_credit_card, volume_debit_card, volume_digital_wallet\nFROM credit_transactions.gold.daily_business_metrics WHERE metric_date >= current_date() - INTERVAL 29 DAYS ORDER BY metric_date DESC\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          }
        ],
        "measures": [
          {
            "name": "total_transactions",
            "expr": "SUM(total_transactions)"
          },
          {
            "name": "total_volume",
            "expr": "SUM(total_volume)"
          },
          {
            "name": "avg_ticket_size",
            "expr": "SUM(avg_ticket_size)"
          },
          {
            "name": "active_customers",
            "expr": "SUM(active_customers)"
          },
          {
            "name": "active_merchants",
            "expr": "SUM(active_merchants)"
          },
          {
            "name": "volume_credit_card",
            "expr": "SUM(volume_credit_card)"
          },
          {
            "name": "volume_debit_card",
            "expr": "SUM(volume_debit_card)"
          },
          {
            "name": "volume_digital_wallet",
            "expr": "SUM(volume_digital_wallet)"
          }
        ]
      }
    },
    {
      "name": "business_payment_mix_30d",
      "displayName": "Business Payment Mix 30 Days",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, payment_method, volume_amount FROM (\n  SELECT metric_date, 'Credit Card' AS payment_method, CAST(volume_credit_card AS DOUBLE) AS volume_amount\n  FROM credit_transactions.gold.daily_business_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n  UNION ALL\n  SELECT metric_date, 'Debit Card' AS payment_method, CAST(volume_debit_card AS DOUBLE) AS volume_amount\n  FROM credit_transactions.gold.daily_business_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n  UNION ALL\n  SELECT metric_date, 'Digital Wallet' AS payment_method, CAST(volume_digital_wallet AS DOUBLE) AS volume_amount\n  FROM credit_transactions.gold.daily_business_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n) t\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          },
          {
            "name": "payment_method",
            "expr": "payment_method"
          }
        ],
        "measures": [
          {
            "name": "volume_amount",
            "expr": "SUM(volume_amount)"
          }
        ]
      }
    }
  ],

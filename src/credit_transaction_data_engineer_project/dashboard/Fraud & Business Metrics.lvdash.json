{
  "datasets": [
    {
      "name": "fraud_metrics_latest",
      "displayName": "Fraud Metrics Latest",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, total_transactions, fraud_count, fraud_rate, fraud_amount_total FROM credit_transactions.gold.daily_fraud_metrics WHERE metric_date = (SELECT MAX(metric_date) FROM credit_transactions.gold.daily_fraud_metrics)\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          }
        ],
        "measures": [
          {
            "name": "total_transactions",
            "expr": "SUM(total_transactions)"
          },
          {
            "name": "fraud_count",
            "expr": "SUM(fraud_count)"
          },
          {
            "name": "fraud_rate",
            "expr": "SUM(fraud_rate)"
          },
          {
            "name": "fraud_amount_total",
            "expr": "SUM(fraud_amount_total)"
          }
        ]
      }
    },
    {
      "name": "fraud_metrics_30d",
      "displayName": "Fraud Metrics 30 Days",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, total_transactions, fraud_count, fraud_rate, fraud_amount_total,\n       fraud_count_online, fraud_count_pos, fraud_count_atm\nFROM credit_transactions.gold.daily_fraud_metrics WHERE metric_date >= current_date() - INTERVAL 29 DAYS ORDER BY metric_date DESC\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          }
        ],
        "measures": [
          {
            "name": "total_transactions",
            "expr": "SUM(total_transactions)"
          },
          {
            "name": "fraud_count",
            "expr": "SUM(fraud_count)"
          },
          {
            "name": "fraud_rate",
            "expr": "SUM(fraud_rate)"
          },
          {
            "name": "fraud_amount_total",
            "expr": "SUM(fraud_amount_total)"
          },
          {
            "name": "fraud_count_online",
            "expr": "SUM(fraud_count_online)"
          },
          {
            "name": "fraud_count_pos",
            "expr": "SUM(fraud_count_pos)"
          },
          {
            "name": "fraud_count_atm",
            "expr": "SUM(fraud_count_atm)"
          }
        ]
      }
    },
    {
      "name": "fraud_activity_30d_long",
      "displayName": "Fraud Activity 30 Days Long",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, metric_name, metric_value FROM (\n  SELECT metric_date, 'Total Transactions' AS metric_name, CAST(total_transactions AS DOUBLE) AS metric_value\n  FROM credit_transactions.gold.daily_fraud_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n  UNION ALL\n  SELECT metric_date, 'Fraud Count' AS metric_name, CAST(fraud_count AS DOUBLE) AS metric_value\n  FROM credit_transactions.gold.daily_fraud_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n) t\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          },
          {
            "name": "metric_name",
            "expr": "metric_name"
          }
        ],
        "measures": [
          {
            "name": "metric_value",
            "expr": "SUM(metric_value)"
          }
        ]
      }
    },
    {
      "name": "fraud_channel_mix_30d",
      "displayName": "Fraud Channel Mix 30 Days",
      "config": {
        "version": "1.1",
        "source": "SELECT metric_date, channel, fraud_count FROM (\n  SELECT metric_date, 'Online' AS channel, CAST(fraud_count_online AS DOUBLE) AS fraud_count\n  FROM credit_transactions.gold.daily_fraud_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n  UNION ALL\n  SELECT metric_date, 'POS' AS channel, CAST(fraud_count_pos AS DOUBLE) AS fraud_count\n  FROM credit_transactions.gold.daily_fraud_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n  UNION ALL\n  SELECT metric_date, 'ATM' AS channel, CAST(fraud_count_atm AS DOUBLE) AS fraud_count\n  FROM credit_transactions.gold.daily_fraud_metrics\n  WHERE metric_date >= current_date() - INTERVAL 29 DAYS\n) t\n",
        "dimensions": [
          {
            "name": "metric_date",
            "expr": "metric_date"
          },
          {
            "name": "channel",
            "expr": "channel"
          }
        ],
        "measures": [
          {
            "name": "fraud_count",
            "expr": "SUM(fraud_count)"
          }
        ]
      }
    },
    {
      "name": "business_metrics_latest",
      "displayName": "Business Metrics Latest",
      "config": {

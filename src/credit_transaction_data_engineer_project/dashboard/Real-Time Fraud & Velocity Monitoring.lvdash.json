{
  "datasets": [
    {
      "name": "f0f7bc5c",
      "displayName": "customer_velocity_alerts",
      "config": {
        "source": "credit_transactions.gold.customer_velocity_alerts",
        "measures": [
          {
            "name": "alert_count",
            "expr": "COUNT(*)",
            "displayName": "Alert Count"
          },
          {
            "name": "total_transactions_flagged",
            "expr": "COALESCE(SUM(source.transaction_count), 0)",
            "displayName": "Total Transactions Flagged"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "window_start",
            "expr": "source.window_start"
          },
          {
            "name": "window_end",
            "expr": "source.window_end"
          },
          {
            "name": "customer_id",
            "expr": "source.customer_id"
          },
          {
            "name": "transaction_count",
            "expr": "source.transaction_count"
          },
          {
            "name": "high_frequency_flag",
            "expr": "source.high_frequency_flag"
          },
          {
            "name": "customer_credit_score",
            "expr": "dim_customer.customer_credit_score"
          },
          {
            "name": "customer_segment",
            "expr": "dim_customer.customer_segment"
          },
          {
            "name": "customer_home_country",
            "expr": "dim_customer.customer_home_country"
          },
          {
            "name": "credit_score_band",
            "expr": "CASE\n  WHEN dim_customer.customer_credit_score >= 750 THEN 'Excellent'\n  WHEN dim_customer.customer_credit_score >= 700 THEN 'Good'\n  WHEN dim_customer.customer_credit_score >= 650 THEN 'Fair'\n  WHEN dim_customer.customer_credit_score IS NULL THEN 'Unknown'\n  ELSE 'Low'\nEND"
          }
        ],
        "joins": [
          {
            "name": "dim_customer",
            "source": "credit_transactions.gold.dim_customer",
            "on": "source.customer_id = dim_customer.customer_id"
          }
        ]
      }
    },
    {
      "name": "fraud_realtime_monitoring",
      "displayName": "fraud_realtime_monitoring",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  transaction_id,\n  customer_id,\n  merchant_id,\n  transaction_time,\n  transaction_date,\n  transaction_amount,\n  transaction_type,\n  country,\n  ip_country,\n  card_type,\n  merchant_risk_level,\n  country_mismatch,\n  fraud_prediction,\n  CAST(from_unixtime(900 * FLOOR(unix_timestamp(transaction_time) / 900)) AS TIMESTAMP) AS bucket_15m\nFROM credit_transactions.gold.scored_transactions WHERE transaction_time >= current_timestamp() - INTERVAL 1 DAY\n",
        "dimensions": [
          {
            "name": "transaction_id",
            "expr": "transaction_id"
          },
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "merchant_id",
            "expr": "merchant_id"
          },
          {
            "name": "transaction_time",
            "expr": "transaction_time"
          },
          {
            "name": "transaction_date",
            "expr": "transaction_date"
          },
          {
            "name": "transaction_amount",
            "expr": "transaction_amount"
          },
          {
            "name": "transaction_type",
            "expr": "transaction_type"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "ip_country",
            "expr": "ip_country"
          },
          {
            "name": "card_type",
            "expr": "card_type"
          },
          {
            "name": "merchant_risk_level",
            "expr": "merchant_risk_level"
          },
          {
            "name": "country_mismatch",
            "expr": "country_mismatch"
          },
          {
            "name": "country_mismatch_label",
            "expr": "CASE WHEN country_mismatch = 1 THEN 'Mismatch' ELSE 'Match' END"
          },
          {
            "name": "fraud_prediction",
            "expr": "fraud_prediction"
          },
          {
            "name": "bucket_15m",
            "expr": "bucket_15m"
          }
        ],
        "measures": [
          {
            "name": "transactions_processed",
            "expr": "COUNT(*)",
            "displayName": "Transactions Processed"
          },
          {
            "name": "fraud_flagged",
            "expr": "COUNT(*) FILTER (WHERE fraud_prediction = 1)",
            "displayName": "Fraud Flagged"
          },
          {
            "name": "fraud_rate",
            "expr": "CASE WHEN MEASURE(transactions_processed) = 0 THEN 0 ELSE MEASURE(fraud_flagged) * 1.0 / MEASURE(transactions_processed) END",
            "displayName": "Fraud Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "amount_flagged_fraud",
            "expr": "COALESCE(SUM(transaction_amount) FILTER (WHERE fraud_prediction = 1), 0)",
            "displayName": "Amount Flagged as Fraud",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "transactions_last_hour",
            "expr": "COUNT(*) FILTER (WHERE transaction_time >= current_timestamp() - INTERVAL 1 HOUR)",
            "displayName": "Transactions Processed Last 1 Hour"
          },
          {
            "name": "fraud_flagged_last_hour",
            "expr": "COUNT(*) FILTER (WHERE fraud_prediction = 1 AND transaction_time >= current_timestamp() - INTERVAL 1 HOUR)",
            "displayName": "Fraud Flagged Last 1 Hour"
          },
          {
            "name": "fraud_rate_last_hour",
            "expr": "CASE WHEN MEASURE(transactions_last_hour) = 0 THEN 0 ELSE MEASURE(fraud_flagged_last_hour) * 1.0 / MEASURE(transactions_last_hour) END",
            "displayName": "Fraud Rate Last 1 Hour",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "amount_flagged_fraud_last_hour",
            "expr": "COALESCE(SUM(transaction_amount) FILTER (WHERE fraud_prediction = 1 AND transaction_time >= current_timestamp() - INTERVAL 1 HOUR), 0)",
            "displayName": "Amount Flagged as Fraud Last 1 Hour",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "transactions_today",
            "expr": "COUNT(*) FILTER (WHERE transaction_date = current_date())",
            "displayName": "Transactions Processed Today"
          },
          {
            "name": "fraud_flagged_today",
            "expr": "COUNT(*) FILTER (WHERE fraud_prediction = 1 AND transaction_date = current_date())",
            "displayName": "Fraud Flagged Today"
          },
          {
            "name": "fraud_rate_today",
            "expr": "CASE WHEN MEASURE(transactions_today) = 0 THEN 0 ELSE MEASURE(fraud_flagged_today) * 1.0 / MEASURE(transactions_today) END",
            "displayName": "Fraud Rate Today",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "amount_flagged_fraud_today",
            "expr": "COALESCE(SUM(transaction_amount) FILTER (WHERE fraud_prediction = 1 AND transaction_date = current_date()), 0)",
            "displayName": "Amount Flagged as Fraud Today",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "minutes_since_last_transaction",
            "expr": "GREATEST(COALESCE(FLOOR((UNIX_TIMESTAMP(current_timestamp()) - UNIX_TIMESTAMP(MAX(transaction_time))) / 60), 0), 0)",
            "displayName": "Minutes Since Last Transaction"
          }
        ]
      }
    },
    {
      "name": "fraud_flagged_transactions",
      "displayName": "fraud_flagged_transactions",
      "queryLines": [
        "SELECT\n",
        "  transaction_id,\n",
        "  customer_id,\n",
        "  merchant_id,\n",
        "  transaction_time,\n",
        "  transaction_amount,\n",
        "  transaction_type,\n",
        "  country,\n",
        "  ip_country,\n",
        "  fraud_prediction\n",
        "FROM\n",
        "  credit_transactions.gold.scored_transactions\n",
        "WHERE\n",
        "  fraud_prediction = 1\n",
        "  AND transaction_time >= current_timestamp() - INTERVAL 1 DAY\n",
        "ORDER BY\n",
        "  transaction_time DESC\n",
        "LIMIT 500"
      ]
    }
  ],
